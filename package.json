{
  "name": "qr-ws-mock",
  "version": "1.0.0",
  "private": true,
  "description": "Мок front-gateway (fgw): WebSocket /identity/v3/auth/qr с поведением QrAuthWebSocketHandler — для локальной проверки авто-реконнекта QR-входа в pep-app",
  "main": "dist/index.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "keywords": [
    "websocket",
    "mock",
    "qr-auth",
    "express",
    "nextjs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
